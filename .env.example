# ==============================================================================
# CANONICAL SERVER-SIDE AUTHENTICATION (CLOUDFLARE PAGES / LOCAL BACKEND)
# Required for Admin Dashboard operations (upload, edit, delete, cloud signing)
# Generate your ADMIN_PASSWORD_HASH & ADMIN_SALT using:
#   node scripts/generate_admin_credentials.cjs
# ==============================================================================
ADMIN_PASSWORD_HASH=your_pbkdf2_sha512_64_byte_hex_password_hash
ADMIN_SALT=your_cryptographic_hex_salt
ADMIN_JWT_SECRET=your_canonical_session_signing_secret

# ==============================================================================
# CLOUDINARY PERMANENT MEDIA STORAGE (FREE PLAN)
# Sign up free at https://cloudinary.com
# Find these 3 credentials in Cloudinary Console: Dashboard > Product Environment Credentials
# NOTE: Server-side only. Never expose CLOUDINARY_API_SECRET in frontend code.
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================================================================
# PROJECT INQUIRY EMAIL SUBMISSION (RESEND)
# ==============================================================================
RESEND_API_KEY=
INQUIRY_TO_EMAIL=girasejitendra249@gmail.com
INQUIRY_FROM_EMAIL="Siddharth Portfolio <onboarding@resend.dev>"

# ==============================================================================
# LEGACY / BACKUP: CLOUDFLARE R2 & D1 (Optional)
# ==============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=siddharth-portfolio-media
